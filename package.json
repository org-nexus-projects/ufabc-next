{
  "name": "@next/workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build --continue",
    "dev": "node scripts/dev.ts",
    "dev:all": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "tsc": "turbo run tsc --parallel",
    "validate": "tsgo -p scripts/tsconfig.json && turbo run lint tsc test build --continue"
  },
  "devDependencies": {
    "@clack/prompts": "1.5.1",
    "@types/node": "26.6.6",
    "@typescript/native-preview": "catalog:",
    "commander": "15.0.0",
    "dotenv": "18.0.9",
    "fastify": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "typescript": "^7.0.0",
    "ultracite": "catalog:",
    "vue-tsgo": "catalog:"
  },
  "engines": {
    "node": "^26.0.0"
  },
  "packageManager": "pnpm@12.16.1"
}
