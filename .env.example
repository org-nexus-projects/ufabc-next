# Shared configuration for the monorepo.
# The selected WEB_<PROFILE> values are exposed to the browser; never place
# secrets in them. Select a profile with Vite's --mode option.

# WEB — apps/web
WEB_LOCAL_APP_ENV=local
WEB_LOCAL_APP_BASE_URL=/
WEB_LOCAL_API_BASE_URL=http://localhost:5000
WEB_LOCAL_PARSER_API_BASE_URL=https://ufabc-parser.com/v2
WEB_LOCAL_MIXPANEL_TOKEN=

WEB_PRODUCTION_APP_ENV=production
WEB_PRODUCTION_APP_BASE_URL=/app
WEB_PRODUCTION_API_BASE_URL=https://api.v2.ufabcnext.com
WEB_PRODUCTION_PARSER_API_BASE_URL=https://ufabc-parser.com/v2
WEB_PRODUCTION_MIXPANEL_TOKEN=

# CORE — apps/core
MONGODB_CONNECTION_URL=mongodb://127.0.0.1:27017/ufabc-matricula
WEB_URL=http://localhost:3000
ALLOWED_ORIGINS=https://sig.ufabc.edu.br,https://matricula.ufabc.edu.br/,http://localhost:3000,http://localhost:5000,https://ufabc-matricula-snapshot.vercel.app/,http://localhost:3003/,https://moodle.ufabc.edu.br

NODE_OPTIONS=--enable-source-maps --max-old-space-size=2048

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID_LOCALSTACK
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY_LOCALSTACK
AWS_BUCKET="ufabc-next"

USE_LOCALSTACK=true

UFABC_PARSER_URL="https://ufabc-parser.com"
UFABC_PARSER_REQUESTER_KEY="example-requester"

BACKOFFICE_EMAILS="next.dev@aluno.ufabc.edu.br"

COMMUNICATIONS_API_URL="https://communications.fundacaonexus.com/v2"
NEXT_AGENT_URL=

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=

# Optional integrations
AXIOM_TOKEN=
AXIOM_DATASET=
NOTION_INTEGRATION_SECRET=
NOTION_DATABASE_ID=
UFABC_PARSER_WEBHOOK_SECRET=
WHATSAPP_AUTH_SECRET=
