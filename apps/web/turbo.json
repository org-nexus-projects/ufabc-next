{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "NEXT_WEB_TARGET",
        "WEB_PRODUCTION_API_BASE_URL",
        "WEB_PRODUCTION_MIXPANEL_TOKEN",
        "VITE_APP_ENV",
        "VITE_APP_BASE_URL",
        "VITE_API_BASE_URL",
        "VITE_PARSER_API_BASE_URL",
        "VITE_MIXPANEL_TOKEN",
        "VITE_AXIOM_TOKEN",
        "VITE_AXIOM_DATASET"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "env": [
        "NEXT_WEB_TARGET",
        "WEB_PRODUCTION_API_BASE_URL",
        "WEB_PRODUCTION_MIXPANEL_TOKEN",
        "VITE_APP_ENV",
        "VITE_APP_BASE_URL",
        "VITE_API_BASE_URL",
        "VITE_PARSER_API_BASE_URL",
        "VITE_MIXPANEL_TOKEN",
        "VITE_AXIOM_TOKEN",
        "VITE_AXIOM_DATASET"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    }
  }
}
